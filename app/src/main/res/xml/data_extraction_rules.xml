<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="file" path="current-backups/latest.json" />
        <include domain="file" path="current-backups/previous.json" />
        <include domain="sharedpref" path="current-backup-status.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="current-backups/latest.json" />
        <include domain="file" path="current-backups/previous.json" />
        <include domain="sharedpref" path="current-backup-status.xml" />
    </device-transfer>
</data-extraction-rules>
