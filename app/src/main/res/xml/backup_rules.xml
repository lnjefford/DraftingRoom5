<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- App-owned recovery snapshots are eligible for encrypted cloud backup. -->
    <include
        domain="file"
        path="current-backups/latest.json"
        requireFlags="clientSideEncryption" />
    <include
        domain="file"
        path="current-backups/previous.json"
        requireFlags="clientSideEncryption" />
    <include
        domain="sharedpref"
        path="current-backup-status.xml"
        requireFlags="clientSideEncryption" />
</full-backup-content>
