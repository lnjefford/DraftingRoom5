<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- App-owned recovery snapshots are eligible for encrypted cloud backup. -->
    <include
        domain="file"
        path="recovery-current/latest.json"
        requireFlags="clientSideEncryption" />
    <include
        domain="file"
        path="recovery-current/previous.json"
        requireFlags="clientSideEncryption" />
    <include
        domain="sharedpref"
        path="backup-status-current.xml"
        requireFlags="clientSideEncryption" />
</full-backup-content>
